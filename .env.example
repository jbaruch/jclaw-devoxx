# Copy to .env (ignored) and supply your key locally.
GOOGLE_API_KEY=your-google-api-key
TYPESAFE_API_KEY=your-typesafe-api-key

# Jev routes/selects events; code assembles facts; Gemini chats; Claude drafts/refines; Codex judges.
# JCLAW_DECIDER=gemini         # explicit comparison; default is jev, with no silent fallback
# Install claude and codex on PATH and log into their subscriptions.
# CLI transport removes inherited API-billing credentials for those stages.
# JCLAW_CLAUDE_MODEL=claude-opus-4-6
# JCLAW_CODEX_MODEL=gpt-6.1-sol
# JCLAW_CODEX_EFFORT=low
# JCLAW_MEMORY_ROOT=/absolute/path/to/memory
# JCLAW_CHAT_FILE=/absolute/path/to/conversation.json
# JCLAW_FLASH=3.7              # supported native profiles: 3.5, 3.6, 3.7
# JCLAW_NAIVE=1                # less context and no long-term retrieval
# JCLAW_AUTOSEND=1             # stdout mock rehearsal only; never overrides critic
# JCLAW_MOCK_DELIVERY=success  # see RUNBOOK.md for negative fixtures

# Optional Koog OpenTelemetry export.
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=your-public-key
# LANGFUSE_SECRET_KEY=your-secret-key

# Optional runtime skill root (defaults to skills/).
# JCLAW_SKILLS_ROOT=/absolute/path/to/skills
# JCLAW_LEVEL=4
# JCLAW_MESSAGE=Your message to rewrite

# Optional local mock bridge for Port (three distinct random values, 32+ characters).
# JCLAW_PORT_READ_TOKEN=generate-locally
# JCLAW_PORT_ACTION_TOKEN=generate-locally
# JCLAW_PORT_SIGNING_KEY=generate-locally
# JCLAW_PORT_PORT=8087
# JCLAW_PORT_ATTEMPTS=/absolute/path/to/port-send-attempts.sqlite
