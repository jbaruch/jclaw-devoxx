# Copy to .env (ignored) and supply your key locally.
GOOGLE_API_KEY=your-google-api-key

# Gemini identifies and chats; Claude drafts/refines; Codex judges.
# Install claude and codex on PATH and log into their subscriptions.
# CLI transport removes inherited API-billing credentials for those stages.
# JCLAW_FLASH=3.7              # supported native profiles: 3.5, 3.6, 3.7
# JCLAW_NAIVE=1                # less context and no long-term retrieval
# JCLAW_AUTOSEND=1             # stdout mock rehearsal only; never overrides critic
# JCLAW_MOCK_DELIVERY=success  # see RUNBOOK.md for negative fixtures

# Optional Koog OpenTelemetry export.
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=your-public-key
# LANGFUSE_SECRET_KEY=your-secret-key

# Optional runtime skill root (defaults to skills/).
# JCLAW_SKILLS_ROOT=/absolute/path/to/skills
# JCLAW_LEVEL=4
# JCLAW_MESSAGE=Your message to rewrite
