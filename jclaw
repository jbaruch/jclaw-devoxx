#!/usr/bin/env bash
# Devoxx launcher: explicit modes; no branch switching or memory resets.
set -euo pipefail
cd "$(dirname "$0")"

usage() {
  cat <<'HELP'
Usage: ./jclaw [workflow|guardrails|observability] [tui|plain]
       ./jclaw round <1-7> [tui|plain]
       ./jclaw doctor
       ./jclaw prepare-demo
       ./jclaw demo <1-7> [tui|plain]
       ./jclaw skills [intensity] 'source message'
       ./jclaw graph [native]
       ./jclaw preview
       ./jclaw codex
       ./jclaw port
       ./jclaw jev [request]
       ./jclaw --help

workflow       Round 5: reviewed proposal or blocked, with no human send prompt.
guardrails     Round 6: human approval/rejection and validated delivery (default).
observability  Round 7: same guardrails path, with round-7 trace metadata.
plain / tui    Guardrails on stdout / terminal UI.
skills         Standalone corporate-speak runner; no delivery.
graph          Generate pipeline.mmd; add native for the native-helper teaching graph.
preview        TamboUI layout rehearsal with labelled fixture data; no providers or actions.
codex          Probe typed Codex output.
port           Local mock HTTP bridge for the native Port workflow; no provider calls.
jev            Read-only live Jev decision probe using the actual calendar MCP.
               Workflows default to Jev; JCLAW_DECIDER=gemini selects the comparison.
HELP
}

mode="${1:-guardrails}"
round_number=""
case "$mode" in
  --help|-h) usage; exit 0 ;;
  doctor) shift ;;
  prepare-demo) exec python3 tools/prepare-demo.py ;;
  demo|round)
    shift
    round_number="${1:-}"
    case "$round_number" in [1-7]) ;; *) usage >&2; exit 2 ;; esac
    shift
    surface="${1:-tui}"
    if [ "$surface" != tui ] && [ "$surface" != plain ]; then usage >&2; exit 2; fi
    if [ "$#" -gt 0 ]; then shift; fi
    if [ "$#" -gt 0 ]; then usage >&2; exit 2; fi
    ;;
  workflow|guardrails|observability)
    if [ "$#" -gt 0 ]; then shift; fi
    surface="${1:-tui}"
    if [ "$surface" != tui ] && [ "$surface" != plain ]; then usage >&2; exit 2; fi
    if [ "$#" -gt 0 ]; then shift; fi
    if [ "$#" -gt 0 ]; then usage >&2; exit 2; fi
    ;;
  tui|plain) surface="$mode"; shift ;;
  skills|graph|codex|preview|port|jev) shift ;;
  *) usage >&2; exit 2 ;;
esac

if [ -f .env ]; then set -a; . ./.env; set +a; fi
if [ "$mode" = doctor ]; then exec python3 tools/check-demo.py; fi
if [ "$mode" != graph ] && [ "$mode" != preview ] && [ "$mode" != port ] && [ "$mode" != jev ] && [ -z "${GOOGLE_API_KEY:-}" ]; then
  echo "GOOGLE_API_KEY is not set. Put it in .env (see .env.example)." >&2
  exit 1
fi

case "$mode" in
  demo|round)
    export JCLAW_ROUND="$round_number" JCLAW_REVIEW_ONLY=0
    if [ "$round_number" = 5 ]; then export JCLAW_REVIEW_ONLY=1; fi
    ;;
  workflow) export JCLAW_ROUND=5 JCLAW_REVIEW_ONLY=1 ;;
  observability) export JCLAW_ROUND=7 JCLAW_REVIEW_ONLY=0 ;;
  *) export JCLAW_ROUND=6 JCLAW_REVIEW_ONLY=0 ;;
esac


if [ "$mode" = demo ]; then
  if [ ! -f build/demo/current ]; then python3 tools/prepare-demo.py; fi
  demo_root="$(cat build/demo/current)"
  case "$round_number" in
    3|4) demo_group=memory-skills ;;
    5) demo_group=workflows ;;
    *) demo_group=guardrails-observability ;;
  esac
  export JCLAW_MEMORY_ROOT="$demo_root/$demo_group/memory"
  if [ "$round_number" = 3 ] || [ "$round_number" = 4 ]; then
    export JCLAW_CHAT_FILE="$demo_root/memory-skills/conversation.json"
  else
    export JCLAW_CHAT_FILE="$demo_root/round-$round_number-conversation.json"
  fi
  echo "[demo] $demo_root / round $round_number"
fi

# The app and Gradle wrapper use JDK 21; avoid inheriting an incompatible IDE JDK.
if [ -x /usr/libexec/java_home ]; then
  JAVA_HOME="$(/usr/libexec/java_home -F -v 21)"
  export JAVA_HOME
fi

./gradlew -q :app:installDist :mocks:mcpJars

case "$mode" in
  skills) entry_point=app-skills ;;
  graph) entry_point=app-graph ;;
  preview) entry_point=app-preview ;;
  codex) entry_point=app-codex ;;
  port) entry_point=app-port ;;
  jev) entry_point=app-jev ;;
  *)
    if [ "$surface" = plain ]; then entry_point=app; else entry_point=app-tui; fi
    ;;
esac

# Keep running files separate from installDist; supervise signals and cleanup.
exec python3 tools/run-isolated.py "$entry_point" "$@"
