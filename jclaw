#!/usr/bin/env bash
# Devoxx launcher: explicit modes; no branch switching or memory resets.
set -euo pipefail
cd "$(dirname "$0")"

usage() {
  cat <<'HELP'
Usage: ./jclaw [workflow|guardrails|observability] [tui|plain]
       ./jclaw skills [intensity] 'source message'
       ./jclaw graph [native]
       ./jclaw preview
       ./jclaw codex
       ./jclaw port
       ./jclaw jev [request]
       ./jclaw --help

workflow       Round 5: reviewed proposal or blocked, with no human send prompt.
guardrails     Round 6: human approval/rejection and validated mock delivery (default).
observability  Round 7: same guardrails path, with round-7 trace metadata.
plain / tui    Guardrails on stdout / terminal UI.
skills         Standalone corporate-speak runner; no delivery.
graph          Generate pipeline.mmd; add native for the native-helper teaching graph.
preview        TamboUI layout rehearsal with labelled fixture data; no providers or actions.
codex          Probe typed Codex output.
port           Local mock HTTP bridge for the native Port workflow; no provider calls.
jev            Read-only live Jev decision probe using the actual calendar MCP.
               Workflows default to Jev; JCLAW_DECIDER=gemini selects the comparison.
HELP
}

mode="${1:-guardrails}"
case "$mode" in
  --help|-h) usage; exit 0 ;;
  workflow|guardrails|observability)
    if [ "$#" -gt 0 ]; then shift; fi
    surface="${1:-tui}"
    if [ "$surface" != tui ] && [ "$surface" != plain ]; then usage >&2; exit 2; fi
    if [ "$#" -gt 0 ]; then shift; fi
    if [ "$#" -gt 0 ]; then usage >&2; exit 2; fi
    ;;
  tui|plain) surface="$mode"; shift ;;
  skills|graph|codex|preview|port|jev) shift ;;
  *) usage >&2; exit 2 ;;
esac

if [ -f .env ]; then set -a; . ./.env; set +a; fi
if [ "$mode" != graph ] && [ "$mode" != preview ] && [ "$mode" != port ] && [ "$mode" != jev ] && [ -z "${GOOGLE_API_KEY:-}" ]; then
  echo "GOOGLE_API_KEY is not set. Put it in .env (see .env.example)." >&2
  exit 1
fi

case "$mode" in
  workflow) export JCLAW_ROUND=5 JCLAW_REVIEW_ONLY=1 ;;
  observability) export JCLAW_ROUND=7 JCLAW_REVIEW_ONLY=0 ;;
  *) export JCLAW_ROUND=6 JCLAW_REVIEW_ONLY=0 ;;
esac

# The app and Gradle wrapper use JDK 21; avoid inheriting an incompatible IDE JDK.
if [ -x /usr/libexec/java_home ]; then
  JAVA_HOME="$(/usr/libexec/java_home -F -v 21)"
  export JAVA_HOME
fi

./gradlew -q :app:installDist :mocks:mcpJars

# Gradle replaces installDist in place. Give this JVM its own files so a later
# build cannot invalidate classes that it has not loaded yet.
mkdir -p build/runtime
runtime_dir="$(mktemp -d "$PWD/build/runtime/run.XXXXXX")"
trap 'rm -rf -- "$runtime_dir"' EXIT
cp -R app/build/install/app "$runtime_dir/app"
mkdir -p "$runtime_dir/mocks"
cp mocks/build/libs/calendar-mcp.jar mocks/build/libs/organizer-mcp.jar "$runtime_dir/mocks/"
export JCLAW_MOCKS_ROOT="$runtime_dir/mocks"

# Keep the shell until the child exits so its private files can be cleaned up.
case "$mode" in
  skills) "$runtime_dir/app/bin/app-skills" "$@" ;;
  graph) "$runtime_dir/app/bin/app-graph" "$@" ;;
  preview) "$runtime_dir/app/bin/app-preview" "$@" ;;
  codex) "$runtime_dir/app/bin/app-codex" ;;
  port) "$runtime_dir/app/bin/app-port" ;;
  jev) "$runtime_dir/app/bin/app-jev" "$@" ;;
  *)
    if [ "$surface" = plain ]; then
      "$runtime_dir/app/bin/app"
    else
      "$runtime_dir/app/bin/app-tui"
    fi
    ;;
esac
